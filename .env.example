# Variables de entorno del proyecto (bot de WhatsApp de BrasPer sobre WAHA).
# Copia este archivo a `.env` (raíz) y/o a `waha/.env` y completa los valores marcados como OBLIGATORIO.
# El servidor lee primero `./.env` y después `waha/.env` (el segundo tiene prioridad). Nunca se commitean los .env reales.
# `npm --prefix waha run setup` genera con claves aleatorias los secretos de WAHA en `waha/.env`.

# ───────────── IA (extracción de monto y monedas) ─────────────
# OBLIGATORIO para la IA: clave de la API de Anthropic. Sin ella el bot pregunta paso a paso.
ANTHROPIC_API_KEY=
# Tiempo máximo de espera de la IA en milisegundos (opcional).
IA_TIMEOUT_MS=6000

# ───────────── Backend: simulado o real (Firebase) ─────────────
# simulado (por defecto): API de demostración sin red. real: funciones, Firestore y Storage del proyecto Firebase de BrasPer.
BACKEND=simulado
# OBLIGATORIO si BACKEND=real. Clave web pública de Firebase (la lleva cualquier app web del proyecto). No es una clave de servicio.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=aibrasper
# Opcionales: solo se cambian para apuntar a un emulador o a un servidor de pruebas.
# FIREBASE_STORAGE_BUCKET=aibrasper.firebasestorage.app
# FIREBASE_IDENTITY_URL=
# FIREBASE_TOKEN_URL=
# FIREBASE_FUNCTIONS_URL=https://{nombre}-h5wenirx2q-rj.a.run.app
# FIREBASE_FIRESTORE_URL=
# FIREBASE_STORAGE_URL=

# ───────────── WAHA (WhatsApp) ─────────────
# OBLIGATORIOS (genéralos con `npm --prefix waha run setup`; deben ser valores distintos entre sí).
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_SECRET=
INTERNAL_API_KEY=
# Panel y Swagger de WAHA.
WAHA_DASHBOARD_USERNAME=waha
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=swagger
WHATSAPP_SWAGGER_PASSWORD=
# Motor de WAHA: NOWEB es el que entrega listas interactivas.
WHATSAPP_DEFAULT_ENGINE=NOWEB
# Etiqueta de la imagen de Docker de WAHA (arm para Mac con Apple Silicon).
WAHA_TAG=arm
WAHA_SESSION=demo
WAHA_PORT=3010
# Solo si el servidor corre en otro lugar que el host (por ejemplo, dentro de Docker).
# WAHA_BASE_URL=http://127.0.0.1:3010
# Dirección a la que WAHA envía los webhooks al crear la sesión (por defecto http://host.docker.internal:APP_PORT/webhooks/waha).
# WEBHOOK_URL=

# ───────────── Servidor del bot ─────────────
APP_PORT=8010
APP_HOST=127.0.0.1
# nativo: todo como lista de WhatsApp. texto: menús numerados en texto plano.
WAHA_INTERACTIVOS=nativo
# Comprobante PDF propio por el chat (solo modo simulado): whatsapp o ninguno.
COMPROBANTE_ENTREGA=whatsapp
# Pausa en milisegundos entre mensajes enviados seguidos (opcional).
PAUSA_ENVIO_MS=700
# Ruta del archivo SQLite (opcional; por defecto waha/data/brasper.db).
# DB_PATH=

# WhatsApp del equipo humano de BrasPer (solo dígitos, con código de país): "Hablar con persona" envía al cliente a ese chat.
WHATSAPP_HUMANO=51966991933

# ───────────── Solo desarrollo ─────────────
# Simulador: fuerza la caída de tasas para probar el mensaje de "sin tasas" (opcional).
# TASAS_CAIDAS=
