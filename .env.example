# Variables obligatorias del proyecto (bot de WhatsApp de BrasPer sobre WAHA).
# Copia este archivo a `.env` y completa los valores. Nunca se commitea el `.env` real.
# `npm --prefix waha run setup` genera con claves aleatorias los secretos de WAHA (WAHA_*, INTERNAL_API_KEY, WHATSAPP_SWAGGER_*).
# El resto de variables (puertos, tiempos, URL de Firebase, etc.) son opcionales y tienen un valor por defecto.

# IA (extrae monto y monedas del primer mensaje)
ANTHROPIC_API_KEY=

# Backend real (Firebase). La clave web es pública, no es una clave de servicio.
BACKEND=real
FIREBASE_API_KEY=

# WAHA (WhatsApp) y servidor del bot
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_SECRET=
INTERNAL_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=
