# Variables de entorno del bot de WhatsApp de BrasPer sobre WAHA.
# Copia este archivo a `.env` y completa las OBLIGATORIAS. Nunca se commitea el `.env` real.
# `npm --prefix waha run setup` genera con claves aleatorias los secretos de WAHA (WAHA_*, INTERNAL_API_KEY, WHATSAPP_SWAGGER_*).
# El servidor lee `./.env` y después `waha/.env` (el segundo tiene prioridad).
# Las variables OPCIONALES están comentadas con su valor por defecto: descoméntalas solo si necesitas cambiarlas.

# ════════════════════════ OBLIGATORIAS ════════════════════════

# IA: extrae monto y monedas del primer mensaje. Sin esta clave el bot pregunta paso a paso.
ANTHROPIC_API_KEY=

# Backend real (Firebase). La clave web es pública, no es una clave de servicio.
BACKEND=real
FIREBASE_API_KEY=

# WAHA (WhatsApp) y servidor del bot
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_SECRET=
INTERNAL_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=

# ════════════════════════ OPCIONALES ════════════════════════

# ── Backend ──
# OPCIONAL. simulado = API de demostración sin red (por defecto); real = funciones, Firestore y Storage de Firebase.
# BACKEND=simulado
# OPCIONAL. Proyecto de Firebase.
# FIREBASE_PROJECT_ID=aibrasper
# OPCIONAL. Solo para apuntar a un emulador o a un servidor de pruebas:
# FIREBASE_STORAGE_BUCKET=aibrasper.firebasestorage.app
# FIREBASE_IDENTITY_URL=https://identitytoolkit.googleapis.com
# FIREBASE_TOKEN_URL=https://securetoken.googleapis.com
# FIREBASE_FUNCTIONS_URL=https://{nombre}-h5wenirx2q-rj.a.run.app
# FIREBASE_FIRESTORE_URL=https://firestore.googleapis.com/v1/projects/aibrasper/databases/(default)/documents
# FIREBASE_STORAGE_URL=https://firebasestorage.googleapis.com

# ── IA ──
# OPCIONAL. Tiempo máximo de espera de la IA, en milisegundos.
# IA_TIMEOUT_MS=6000

# ── WAHA ──
# OPCIONAL. Motor de WAHA: NOWEB entrega las listas interactivas.
# WHATSAPP_DEFAULT_ENGINE=NOWEB
# OPCIONAL. Etiqueta de la imagen de Docker de WAHA (arm para Mac con Apple Silicon).
# WAHA_TAG=arm
# OPCIONAL. Nombre de la sesión de WhatsApp y puerto de WAHA en tu máquina.
# WAHA_SESSION=demo
# WAHA_PORT=3010
# OPCIONAL. Solo si el servidor corre en otro lugar que el host (por ejemplo, dentro de Docker).
# WAHA_BASE_URL=http://127.0.0.1:3010
# OPCIONAL. Dirección a la que WAHA envía los webhooks al crear la sesión.
# WEBHOOK_URL=http://host.docker.internal:8010/webhooks/waha

# ── Servidor del bot ──
# OPCIONAL. Puerto y dirección donde escucha el servidor.
# APP_PORT=8010
# APP_HOST=127.0.0.1
# OPCIONAL. nativo = todo como lista de WhatsApp; texto = menús numerados en texto plano.
# WAHA_INTERACTIVOS=texto
# OPCIONAL. Comprobante PDF propio por el chat (solo en modo simulado): whatsapp o ninguno.
# COMPROBANTE_ENTREGA=whatsapp
# OPCIONAL. Pausa entre mensajes enviados seguidos, en milisegundos.
# PAUSA_ENVIO_MS=700
# OPCIONAL. Ruta del archivo SQLite.
# DB_PATH=waha/data/brasper.db

# ── Equipo humano ──
# OPCIONAL. WhatsApp del equipo humano de BrasPer (solo dígitos, con código de país).
# "Hablar con persona" envía al cliente a ese chat.
# WHATSAPP_HUMANO=51966991933

# ── Solo desarrollo ──
# OPCIONAL. Simulador: fuerza la caída de tasas para probar el mensaje de "sin tasas".
# TASAS_CAIDAS=
